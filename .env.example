# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) or legacy service_role key (eyJ...). Server-side only, never share it.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=media

# Admin panel login password
ADMIN_PASSWORD=change-me
# Long random string used to sign the login cookie, e.g. `openssl rand -hex 32`
APP_SECRET=

# Optional: your public domain (https://cards.example.com). Auto-detected when empty.
APP_URL=
